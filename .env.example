# ==============================
# App
# ==============================
VITE_APP_NAME=SaaS Platform
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# ==============================
# Supabase
# ==============================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only (used in Netlify Functions), never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================
# Backblaze B2 (S3-compatible storage)
# ==============================
VITE_B2_BUCKET_NAME=your-bucket-name
VITE_B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
VITE_B2_REGION=us-west-002
B2_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_ID=your-bucket-id

# ==============================
# Redis (Upstash)
# ==============================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ==============================
# Resend (Transactional Email)
# ==============================
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=SaaS Platform <no-reply@yourdomain.com>

# ==============================
# PostHog (Product Analytics)
# ==============================
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ==============================
# Razorpay (Billing - optional, mock mode used until configured)
# ==============================
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_BILLING_MODE=mock
